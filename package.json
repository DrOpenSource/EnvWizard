{
  "name": "envwizard",
  "displayName": "EnvWizard",
  "description": "Port unjammer & .env checker for vibe coders. See what is holding port 3000, free it safely in one click, and find env variables your code needs but your .env is missing.",
  "version": "0.1.3",
  "publisher": "dr-opensource",
  "license": "MIT",
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/DrOpenSource/EnvWizard.git"
  },
  "bugs": {
    "url": "https://github.com/DrOpenSource/EnvWizard/issues"
  },
  "homepage": "https://envwizard.taqnik.in",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "port",
    "kill port",
    "eaddrinuse",
    "env",
    "dotenv",
    "vibe coding",
    "dev doctor"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "envwizard.scanPorts",
        "title": "EnvWizard: Scan Dev Ports & Show Radar",
        "category": "EnvWizard"
      },
      {
        "command": "envwizard.unjamPort",
        "title": "EnvWizard: 1-Click Unjam Specific Port",
        "category": "EnvWizard"
      },
      {
        "command": "envwizard.cleanSlate",
        "title": "EnvWizard: Clean Slate (Kill All Dev Zombies)",
        "category": "EnvWizard"
      },
      {
        "command": "envwizard.auditEnv",
        "title": "EnvWizard: Audit & Heal .env Variables",
        "category": "EnvWizard"
      },
      {
        "command": "envwizard.generateEnvExample",
        "title": "EnvWizard: Create or Update .env.example",
        "category": "EnvWizard"
      },
      {
        "command": "envwizard.restoreSnapshot",
        "title": "EnvWizard: Restore .env Snapshot…",
        "category": "EnvWizard"
      },
      {
        "command": "envwizard.activateLicense",
        "title": "EnvWizard: Activate Pro License",
        "category": "EnvWizard"
      },
      {
        "command": "envwizard.buyLicense",
        "title": "EnvWizard: About EnvWizard Pro ($9.99 once)",
        "category": "EnvWizard"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "envwizard-deck",
          "title": "EnvWizard",
          "icon": "assets/activity-icon.svg"
        }
      ]
    },
    "views": {
      "envwizard-deck": [
        {
          "type": "webview",
          "id": "envwizard.devDeck",
          "name": "Dev Deck"
        }
      ]
    },
    "configuration": {
      "title": "EnvWizard",
      "properties": {
        "envwizard.watchedPorts": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "default": [
            3000,
            3001,
            3002,
            5173,
            5174,
            8000,
            8080,
            8888,
            5432,
            6379,
            27017,
            4200,
            4000
          ],
          "description": "Ports shown in the status bar radar and Dev Deck. Clean Slate never stops databases or protected programs on these ports."
        },
        "envwizard.scanIntervalSeconds": {
          "type": "number",
          "minimum": 2,
          "default": 5,
          "description": "How often (in seconds) the status bar checks the watched ports."
        },
        "envwizard.terminalDetection": {
          "type": "boolean",
          "default": true,
          "description": "Watch terminal commands and offer 1-click unjam when a dev server hits a port-in-use error."
        },
        "envwizard.autoUnjam": {
          "type": "boolean",
          "default": false,
          "description": "(Pro) Automatically free port jams caused by previous runs of this project without asking."
        },
        "envwizard.envWatcher": {
          "type": "boolean",
          "default": false,
          "description": "(Pro) When you save a code file that uses an env variable no env file defines, tell me and offer to add it."
        },
        "envwizard.snapshots": {
          "type": "boolean",
          "default": false,
          "description": "(Pro) Keep encrypted local snapshots of .env files (at startup, around saves and before EnvWizard edits them) and restore them with EnvWizard: Restore .env Snapshot."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./ --noEmit",
    "build": "node esbuild.config.mjs",
    "build:site": "node scripts/build-site.mjs",
    "deploy:site": "npm run build:site && npx wrangler deploy",
    "watch": "node esbuild.config.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "npm run build && node test/integration/run.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/vscode": "^1.93.0",
    "@vscode/test-electron": "^2.4.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
